<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MarkitaiApp.Views.UrlBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:MarkitaiApp">
    <StackPanel Spacing="8">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="Field"
                PlaceholderText="{m:S Key=convert.url.placeholder}"
                AutomationProperties.Name="{m:S Key=convert.url.label}"
                InputScope="Url"
                IsSpellCheckEnabled="False"
                KeyDown="Field_KeyDown"
                TextChanged="Field_TextChanged" />
            <FontIcon
                x:Name="LinkGlyph"
                Glyph="&#xE71B;"
                FontSize="16"
                Margin="12,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="1" Content="{m:S Key=convert.url.add}" Click="Add_Click" />
        </Grid>
        <StackPanel x:Name="Error" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
            <FontIcon Glyph="&#xEA39;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <TextBlock Text="{m:S Key=convert.url.invalid}" TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</UserControl>
