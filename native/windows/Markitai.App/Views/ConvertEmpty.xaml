<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MarkitaiApp.Views.ConvertEmpty"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:MarkitaiApp"
    xmlns:views="using:MarkitaiApp.Views">
    <Grid Padding="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{m:S Key=nav.convert}" Style="{StaticResource TitleTextBlockStyle}" Margin="0,8,0,0" />
        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <!-- The ScrollViewer centers its content by the width the content measured, so the zone's
                 width is set outright: the viewport's, capped at 560. Stretched, the zone was drawn
                 wider than it measured and landed off center, past the right edge when narrow. -->
            <Grid Width="{x:Bind Scroller.ViewportWidth, Mode=OneWay}" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24">
                <Rectangle
                    x:Name="Zone"
                    RadiusX="8"
                    RadiusY="8"
                    StrokeThickness="1"
                    StrokeDashArray="4,3"
                    Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                <Rectangle
                    x:Name="ZoneActive"
                    RadiusX="8"
                    RadiusY="8"
                    StrokeThickness="1"
                    Visibility="Collapsed"
                    Stroke="{ThemeResource AccentFillColorDefaultBrush}" />
                <StackPanel Padding="40" Spacing="12" AutomationProperties.Name="{m:S Key=a11y.drop_zone}">
                    <FontIcon Glyph="&#xE8E5;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="Heading" Text="{m:S Key=convert.empty.title}" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock x:Name="Body" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button
                        x:Name="Choose"
                        Content="{m:S Key=convert.choose}"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Click="Choose_Click" />
                    <Grid ColumnSpacing="12" Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Height="1" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock Grid.Column="1" Text="{m:S Key=convert.or}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    </Grid>
                    <views:UrlBox x:Name="Url" />
                    <InfoBar x:Name="NoticeBar" IsClosable="True" Closed="NoticeBar_Closed" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
