<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MarkitaiApp.Views.ConvertList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:MarkitaiApp"
    xmlns:core="using:Markitai.Core"
    xmlns:views="using:MarkitaiApp.Views">
    <Grid Padding="24,0,12,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{m:S Key=nav.convert}" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent" OverflowButtonVisibility="Collapsed">
                <AppBarButton x:Name="ClearFinished" Label="{m:S Key=convert.clear_finished}" Click="ClearFinished_Click">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE894;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <Grid Grid.Row="1" Height="48" Padding="12,0,8,0" ColumnSpacing="12" AutomationProperties.Name="{m:S Key=a11y.drop_zone}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Rectangle x:Name="Bar" Grid.ColumnSpan="3" Margin="-12,0,-8,0" RadiusX="8" RadiusY="8" StrokeThickness="1" StrokeDashArray="4,3" Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
            <Rectangle x:Name="BarActive" Grid.ColumnSpan="3" Margin="-12,0,-8,0" RadiusX="8" RadiusY="8" StrokeThickness="1" Visibility="Collapsed" Stroke="{ThemeResource AccentFillColorDefaultBrush}" />
            <FontIcon Glyph="&#xE8E5;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="BarLabel" Grid.Column="1" Text="{m:S Key=convert.drop.bar}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="Choose" Grid.Column="2" Content="{m:S Key=convert.choose}" Click="Choose_Click" />
        </Grid>

        <views:UrlBox x:Name="Url" Grid.Row="2" />

        <InfoBar x:Name="NoticeBar" Grid.Row="3" IsClosable="True" Closed="NoticeBar_Closed" />

        <ListView
            x:Name="List"
            Grid.Row="4"
            Margin="-12,0,-4,0"
            SelectionMode="Single"
            IsItemClickEnabled="True"
            AutomationProperties.Name="{m:S Key=a11y.conversions}"
            SelectionChanged="List_SelectionChanged"
            ItemClick="List_ItemClick"
            ContainerContentChanging="List_ContainerContentChanging"
            ContextRequested="List_ContextRequested">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:ConversionItem">
                    <Grid Height="60" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{x:Bind m:Ui.KindGlyph(Source)}" FontSize="16" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock
                                Text="{x:Bind m:Ui.Subtitle(State), Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                MaxLines="1" />
                        </StackPanel>
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE917;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind m:Ui.QueuedVisible(State), Mode=OneWay}" />
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind m:Ui.SpinnerActive(State), Mode=OneWay}" Visibility="{x:Bind m:Ui.SpinnerVisible(State), Mode=OneWay}" />
                            <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind m:Ui.WarningVisible(State), Mode=OneWay}" />
                            <FontIcon Glyph="&#xEA39;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind m:Ui.FailedVisible(State), Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
