<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MarkitaiApp.Views.DetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:MarkitaiApp"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:MarkitaiApp.Views"
    ActualThemeChanged="DetailView_ActualThemeChanged">
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Detail bar: view switch and actions (Done items and History entries only). -->
        <Grid x:Name="Bar" Padding="24,8,12,0" ColumnSpacing="12" MinHeight="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <views:ViewSwitch
                x:Name="ViewSwitch"
                VerticalAlignment="Center"
                SelectedIndex="0"
                AutomationProperties.Name="{m:S Key=detail.view}"
                SelectionChanged="ViewSwitch_SelectionChanged">
                <toolkit:SegmentedItem Content="{m:S Key=detail.preview}" />
                <toolkit:SegmentedItem Content="{m:S Key=detail.markdown}" />
                <views:ViewSwitch.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control,Shift" Key="M" Invoked="SwitchView_Invoked" />
                </views:ViewSwitch.KeyboardAccelerators>
            </views:ViewSwitch>
            <CommandBar
                Grid.Column="1"
                HorizontalAlignment="Right"
                DefaultLabelPosition="Right"
                Background="Transparent"
                OverflowButtonVisibility="Collapsed">
                <AppBarButton x:Name="CopyButton" Label="{m:S Key=detail.copy}" Click="Copy_Click">
                    <AppBarButton.Icon>
                        <FontIcon x:Name="CopyGlyph" Glyph="&#xE8C8;" />
                    </AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="C" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Name="SaveButton" Label="{m:S Key=detail.save_as}" Click="SaveAs_Click">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE792;" />
                    </AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="S" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Name="ShowButton" Label="{m:S Key=detail.show.windows}" Click="Show_Click">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE838;" />
                    </AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="R" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <!-- Header: title, source, status. -->
        <StackPanel x:Name="Header" Grid.Row="1" Padding="24,12,24,8" Spacing="4">
            <TextBlock
                x:Name="TitleText"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                IsTextSelectionEnabled="True" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="SourceGlyph" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="SourceText"
                    Grid.Column="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    IsTextSelectionEnabled="True" />
            </Grid>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center">
                    <FontIcon x:Name="StatusGlyph" FontSize="14" />
                    <ProgressRing x:Name="StatusRing" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="StatusText" Grid.Column="1" TextWrapping="Wrap" />
            </Grid>
        </StackPanel>

        <!-- Warnings: collapsed by default, state kept per item for the session. -->
        <Expander
            x:Name="WarningsBox"
            Grid.Row="2"
            Margin="24,4,24,8"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.Name="{m:S Key=a11y.warnings}"
            Expanding="WarningsBox_Expanding"
            Collapsed="WarningsBox_Collapsed">
            <Expander.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock x:Name="WarningsLabel" VerticalAlignment="Center" />
                </StackPanel>
            </Expander.Header>
            <StackPanel x:Name="WarningLines" Spacing="6" />
        </Expander>

        <!-- Body. -->
        <Grid Grid.Row="3">
            <WebView2
                x:Name="Preview"
                Margin="12,0,0,0"
                Visibility="Collapsed"
                DefaultBackgroundColor="Transparent"
                AutomationProperties.Name="{m:S Key=a11y.preview}" />
            <TextBlock
                x:Name="PreviewMissing"
                Margin="24"
                Visibility="Collapsed"
                TextWrapping="Wrap"
                Text="{m:S Key=preview.webview2_missing}" />
            <TextBox
                x:Name="MarkdownText"
                Visibility="Collapsed"
                IsReadOnly="True"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                IsSpellCheckEnabled="False"
                BorderThickness="0"
                Background="Transparent"
                Padding="24"
                FontFamily="{StaticResource MarkdownFont}"
                FontSize="13"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                AutomationProperties.Name="{m:S Key=a11y.markdown_text}" />
            <StackPanel
                x:Name="Message"
                Visibility="Collapsed"
                MaxWidth="480"
                Margin="24"
                Spacing="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock x:Name="MessageTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                <TextBlock x:Name="MessageBody" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" IsTextSelectionEnabled="True" />
                <Button x:Name="MessageButton" HorizontalAlignment="Center" Content="{m:S Key=history.remove}" Click="MessageButton_Click" />
            </StackPanel>
            <ScrollViewer x:Name="ErrorBlock" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="24,8,24,24" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock x:Name="ErrorSentence" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RetryButton" Style="{StaticResource AccentButtonStyle}" Content="{m:S Key=detail.retry}" Click="Retry_Click">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="R" />
                            </Button.KeyboardAccelerators>
                        </Button>
                        <Button x:Name="SecondButton" Click="SecondButton_Click" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{m:S Key=detail.details}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Border
                            Padding="12"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <TextBlock
                                x:Name="ErrorDetails"
                                FontFamily="{StaticResource MarkdownFont}"
                                FontSize="12"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock
            x:Name="Footer"
            Grid.Row="4"
            Padding="24,8,24,12"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
    </Grid>
</UserControl>
