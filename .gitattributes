# Every text file is stored and checked out with LF on every platform. Tests
# compare embedded copies, fixtures and help text byte for byte, so a Windows
# checkout must not rewrite them to CRLF.
* text=auto eol=lf

# Captured evidence keeps the exact bytes it was recorded with.
docs/validation/linux-desktop-proxy-round38/packages.txt -text

