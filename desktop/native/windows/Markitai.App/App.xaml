<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MarkitaiApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Ink ramp (desktop/DESIGN.md 13.2). High-contrast themes draw with system colors and never read these. -->
            <Color x:Key="SystemAccentColorLight3">#FAFAFA</Color>
            <Color x:Key="SystemAccentColorLight2">#F4F4F5</Color>
            <Color x:Key="SystemAccentColorLight1">#D4D4D8</Color>
            <Color x:Key="SystemAccentColor">#71717A</Color>
            <Color x:Key="SystemAccentColorDark1">#18181B</Color>
            <Color x:Key="SystemAccentColorDark2">#09090B</Color>
            <Color x:Key="SystemAccentColorDark3">#000000</Color>
            <FontFamily x:Key="MarkdownFont">Cascadia Mono, Consolas</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
