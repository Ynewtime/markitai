<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MarkitaiApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:MarkitaiApp"
    xmlns:views="using:MarkitaiApp.Views">
    <Grid
        x:Name="Root"
        AllowDrop="True"
        DragOver="Root_DragOver"
        DragLeave="Root_DragLeave"
        Drop="Root_Drop"
        PreviewKeyDown="Root_PreviewKeyDown"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" ColumnSpacing="12" Padding="16,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleIcon" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{m:S Key=app.name.native}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Auto"
            OpenPaneLength="200"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            IsBackEnabled="True"
            IsPaneToggleButtonVisible="True"
            AlwaysShowHeader="False"
            DisplayModeChanged="Nav_DisplayModeChanged"
            SelectionChanged="Nav_SelectionChanged"
            BackRequested="Nav_BackRequested">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="ConvertItem" Content="{m:S Key=nav.convert}" Tag="convert">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C3;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="HistoryItem" Content="{m:S Key=nav.history}" Tag="history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsItem" Content="{m:S Key=nav.settings}" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid x:Name="Workspace" SizeChanged="Workspace_SizeChanged">
                <Grid x:Name="Panes">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ListColumn" Width="320" />
                        <ColumnDefinition x:Name="DetailColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <views:ConvertList x:Name="ConvertPane" />
                    <views:HistoryList x:Name="HistoryPane" Visibility="Collapsed" />
                    <views:DetailView x:Name="Detail" Grid.Column="1" />
                </Grid>
                <views:ConvertEmpty x:Name="ConvertEmptyView" />
                <Grid x:Name="HistoryEmptyView" Visibility="Collapsed" Padding="24,0,24,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{m:S Key=nav.history}" Style="{StaticResource TitleTextBlockStyle}" Margin="0,8,0,0" />
                    <StackPanel Grid.Row="1" Spacing="8" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE81C;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{m:S Key=history.empty.title}" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="{m:S Key=history.empty.body}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <views:SettingsPage x:Name="SettingsView" Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
